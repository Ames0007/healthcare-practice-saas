# Environment configuration example.
#
# No real secrets belong in this file or in this repository.
# Copy to .env locally and fill in real values; .env is gitignored.
#
# Frontend/backend application config lives in frontend/.env.local and
# backend/.env respectively (see their own .env.example files). This root
# file documents the local development infrastructure only (TASK-004).

# --- Application (backend, as of TASK-002) ---
# The authoritative Laravel environment template is backend/.env.example.
# Copy it to backend/.env and run `php artisan key:generate` inside
# backend/ — see backend/README.md.

# --- Local development infrastructure (TASK-004) ---
# PostgreSQL, Redis and MinIO run as native/portable processes on this
# machine (no Docker available — see docs/implementation/DECISIONS.md
# ADR-002 and docs/development/LOCAL_DEVELOPMENT.md). Started/stopped via
# scripts/dev-up.sh / scripts/dev-down.sh, which read this file if copied
# to .env, otherwise fall back to the same defaults shown here.
#
# Dev-only placeholder values. Never used in staging/production, and
# unrelated to backend/.env's real DB_*/REDIS_* connection settings
# (backend/.env.example targets these same defaults — see TASK-005 for
# actual PostgreSQL application-level connectivity).

POSTGRES_DB=healthcare_practice
# Dedicated test database (TASK-005) — never the same as POSTGRES_DB, so
# `php artisan test` cannot accidentally target normal development data.
POSTGRES_TEST_DB=healthcare_practice_test
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_dev_only
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=healthcare_dev
MINIO_ROOT_PASSWORD=healthcare_dev_only_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=healthcare-practice-dev
