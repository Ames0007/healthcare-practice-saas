APP_NAME="Healthcare Practice Management SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL per ADR-001. TASK-004 provisions a local PostgreSQL instance
# (native/portable, see ADR-002 and docs/development/LOCAL_DEVELOPMENT.md)
# with these exact credentials — copy as-is for local development.
# TASK-005 (see backend/database/README.md) establishes the application-
# level foundation: UUID/timestamp/money conventions, migration baseline
# (deliberately empty — see database/migrations/README.md), test DB. These
# are dev-only placeholder values, never real credentials.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=healthcare_practice
DB_USERNAME=healthcare
DB_PASSWORD=healthcare_dev_only
DB_TIMEZONE=UTC

# file, not database: TASK-005 removed the default sessions/cache/jobs
# migrations (see database/migrations/README.md) rather than keep an
# unreviewed schema. Revisit when a concrete reason exists (e.g. Redis
# cache in TASK-006, or a session-storage decision in Identity).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync, not database: no queue architecture exists yet — TASK-006 owns
# the real Redis/queue foundation. sync runs jobs in-process immediately,
# with no schema/persistence dependency in the meantime.
QUEUE_CONNECTION=sync

# Comma-separated list of allowed frontend origins for CORS (api/* only).
CORS_ALLOWED_ORIGINS=http://localhost:3000

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis, not the default phpredis: the portable Windows PHP build
# (TASK-002) has no native phpredis extension. See ADR-002.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible connection info for the local MinIO instance (TASK-004).
# FILESYSTEM_DISK stays "local" — no application file-storage behavior is
# implemented yet; these variables just document local connectivity for
# whichever future task wires up the "s3" disk for real.
AWS_ACCESS_KEY_ID=healthcare_dev
AWS_SECRET_ACCESS_KEY=healthcare_dev_only_password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=healthcare-practice-dev
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
